rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Cek apakah user sudah login
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Cek apakah user memiliki role "admin" di database
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 1. KOLEKSI USERS
    match /users/{uid} {
      allow read: if isSignedIn();
      
      // Saat registrasi pertama, user hanya boleh membuat dokumen dirinya dengan role "user"
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "user";

      // User hanya boleh mengubah nama & kelas miliknya sendiri (tidak boleh mengubah role/badge)
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
    }

    // 2. DOKUMEN UANG KAS (kas/current)
    match /kas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. KOLEKSI ANGGOTA & CHECKLIST MINGGUAN
    match /anggota/{anggotaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. KOLEKSI LOG TRANSAKSI
    match /transaksi/{transaksiId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.nominal is number
        && request.resource.data.aksi in ["tambah", "kurang"];
      allow update, delete: if false; // Log transaksi bersifat permanen (immutable)
    }

    // 5. KOLEKSI CHAT LIMITS (Kuota 10 pesan per hari per user)
    match /chatLimits/{limitId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && limitId == (request.auth.uid + "_" + request.resource.data.tanggal)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;

      allow update: if isSignedIn()
        && limitId == (request.auth.uid + "_" + request.resource.data.tanggal)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 10;
    }

    // 6. KOLEKSI CHATS (Validasi maks 100 karakter & wajib terhubung dengan chatLimits <= 10)
    match /chats/{chatId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pesan is string
        && request.resource.data.pesan.size() > 0
        && request.resource.data.pesan.size() <= 100
        && getAfter(/databases/$(database)/documents/chatLimits/$(request.auth.uid + "_" + request.resource.data.tanggal)).data.count <= 10;

      allow update, delete: if false;
    }
  }
}
